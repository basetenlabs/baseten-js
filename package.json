{
  "name": "baseten",
  "version": "0.1.0",
  "description": "Baseten JS SDK",
  "type": "module",
  "exports": {
    "./client": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "generate-api": "tsx scripts/apigen/main.ts",
    "build": "tsdown src/client/index.ts --platform neutral --dts",
    "test": "vitest run",
    "lint": "biome check . && tsc --noEmit",
    "format": "biome check --fix ."
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/basetenlabs/baseten-js"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.33.0",
  "devDependencies": {
    "@biomejs/biome": "^1",
    "@types/node": "^25.5.0",
    "openapi-typescript": "^7.13.0",
    "tsdown": "^0",
    "tsx": "^4",
    "typescript": "^5",
    "vitest": "^3"
  }
}
