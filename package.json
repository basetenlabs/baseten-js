{
  "name": "baseten-js",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "generate-api": "pnpm --filter @basetenlabs/client generate-api",
    "sync-version": "pnpm --filter @basetenlabs/client sync-version",
    "build": "pnpm -r run build",
