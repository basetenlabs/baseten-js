  "devDependencies": {
    "@types/node": "^25.9.7",
    "oxfmt": "^0.68.0",
    "oxlint": "^1.83.0",
    "tsdown": "^0.23.0",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@12.18.0"
}
