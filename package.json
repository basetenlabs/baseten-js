{
  "name": "baseten",
  "version": "0.1.0",
  "description": "Baseten JS SDK",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/basetenlabs/baseten-js"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    "./client": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "generate-api": "tsx scripts/apigen/main.ts",
    "build": "tsdown src/client/index.ts --platform neutral --dts",
    "test": "vitest run",
    "lint": "oxlint --ignore-pattern dist && oxfmt --check . && tsc --noEmit",
    "lint:fix": "oxlint --fix --ignore-pattern dist",
    "format": "oxfmt --write ."
  },
  "devDependencies": {
    "@types/node": "^25.5.0",
    "openapi-typescript": "^7.13.0",
    "oxfmt": "^0.43.0",
    "oxlint": "^1.58.0",
    "tsdown": "^0",
    "tsx": "^4",
    "typescript": "^5",
    "vitest": "^3"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.33.0"
}
